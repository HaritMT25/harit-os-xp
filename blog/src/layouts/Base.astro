---
import '../styles/blog.css'
import { SITE_TITLE, url } from '../lib/site.js'

const {
  title,
  description = '',
  image = null,
  type = 'website',
  published = null,
  noindex = false,
} = Astro.props

const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = image ? new URL(image, Astro.site).href : null
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url('rss.xml')} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title || SITE_TITLE} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={url()}><span aria-hidden="true">📰</span> {SITE_TITLE}</a>
        <nav class="site-nav" aria-label="Site">
          <a href={url()}>Posts</a>
          <a href="/" target="_top">Portfolio</a>
          <a href={url('rss.xml')}>RSS</a>
        </nav>
      </div>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Harit Tarwani</span>
      <a href="/" target="_top">harit-os-xp.vercel.app</a>
    </footer>
    <script>
      import { inject } from '@vercel/analytics'
      import { isOwner } from '../scripts/owner.js'
      // the owner's own browsers are left out of analytics, as on the XP site
      inject({ beforeSend: e => (isOwner() ? null : e) })
    </script>
  </body>
</html>
