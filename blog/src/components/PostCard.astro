---
import { url, slugOf, fmtDate, readingTime } from '../lib/site.js'
const { post } = Astro.props
const slug = slugOf(post)
const { title, date, summary, tags, cover, cover_alt, draft } = post.data
---
<li class="card" data-tags={tags.join(',')}>
  <a class="card-link" href={url(`${slug}/`)}>
    <div class="card-text">
      <div class="meta">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        <span>· {readingTime(post.body)} min read</span>
        <span class="views" data-views-for={slug} hidden></span>
        {draft && <span class="pill pill-draft">Draft</span>}
      </div>
      <h2 class="card-title">{title}</h2>
      {summary && <p class="card-summary">{summary}</p>}
      {tags.length > 0 && (
        <div class="pills">{tags.map(t => <span class={`pill pill-${t.toLowerCase()}`}>{t}</span>)}</div>
      )}
    </div>
    {cover && <img class="card-cover" src={cover} alt={cover_alt} loading="lazy" decoding="async" />}
  </a>
</li>
