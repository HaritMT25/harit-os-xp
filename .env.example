# HaritBot AI assistant — get key at https://console.groq.com
# Production (Vercel): set GROQ_API_KEY — used only by the api/chat.js
# serverless proxy, never shipped to the browser.
GROQ_API_KEY=gsk_your_key_here
# Local dev only: lets `npm run dev` call Groq directly without `vercel dev`.
# Stripped from production builds — do NOT rely on it in prod.
VITE_GROQ_API_KEY=gsk_your_key_here

# Visitor map persistence
# local docker: redis://localhost:6379
# upstash (note the double s for TLS): rediss://default:password@your-host.upstash.io:6379
REDIS_URL=redis://localhost:6379
